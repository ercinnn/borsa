SUPABASE_URL=https://riugphrucjbiaomuylqh.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key
# Opsiyonel: coingecko.com/en/developers/dashboard üzerinden ücretsiz bir
# "Demo" API anahtarı alıp buraya koyarsan crypto200 preset'i CoinGecko'nun
# çok daha yüksek limitli ucunu kullanır. Boş bırakılırsa anahtarsız,
# düşük limitli uca (ve gerekirse statik yedek listeye) düşülür.
COINGECKO_API_KEY=your-demo-api-key
# Opsiyonel: verilirse POST /api/admin/sync-stock/{symbol} bu değeri
# X-Admin-Secret header'ında bekler (kullanıcı auth'u değil, servis-to-servis
# manuel tetikleme sırrı). Boş/tanımsızsa uç nokta tamamen kapalı (503) döner.
ADMIN_SYNC_SECRET=your-random-admin-sync-secret
